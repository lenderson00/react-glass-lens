{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "react-glass-lens": [
        "./packages/react-glass-lens/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "packages/react-glass-lens/src"
  ]
}
